{
  "manifest_version": 3,
  "name": "Fake Fullscreen",
  "version": "2.0",
  "description": "Makes a website believe your tab is in real fullscreen while the browser stays in normal windowed mode. Toolbar button or Ctrl/Cmd+Shift+F toggles it per site.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "service_worker.js" },
  "action": {
    "default_title": "Toggle Fake Fullscreen for this site",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-fake-fullscreen": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Toggle fake fullscreen for the current site"
    }
  }
}
